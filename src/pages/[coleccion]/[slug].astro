---
// Ficha de un lugar con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /que-ver/<slug>/.
// Diseño «cartel del pueblo»: banda verde hondo con migas y hero partido (título serif grande, entradilla y botones;
// foto a sangre por la derecha con filete de acento o, sin foto, el icono grande sobre color pleno); banda blanco cal
// con el `detalle` (capitular) y, al lado, ficha con filetes y bloque de la oficina; franja de fotos a sangre
// (`imagenes`); y otros lugares de la misma lista en banda piedra con rejilla de filetes, sin tarjetas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = seccion('contacto') ? enlace('/#contacto') : site.boton_cabecera?.url || enlace('/#contacto');
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-hondo ficha-cabeza">
    <div class="contenedor ficha-migas-caja">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
    </div>
    <div class="ficha-hero">
      <div class="ficha-hero-texto">
        <p class="antetitulo">{f.categoria || f.def.nombre}</p>
        <h1 class="titulo-seccion">{f.titulo}</h1>
        {f.texto && <p class="titular-texto">{f.texto}</p>}
        {f.precio && <p class="ficha-precio">{f.precio}</p>}
        <div class="ficha-botones">
          <a class="btn" href={contacto}>Pide el plano del pueblo</a>
          {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
        </div>
      </div>
      {f.imagen ? (
        <div class="ficha-foto">
          <Imagen src={f.imagen} alt={f.titulo} ancho={1400} alto={1050} prioridad class="h-full w-full object-cover" />
        </div>
      ) : (
        <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'montana'} tam={110} /></div>
      )}
    </div>
  </section>

  <section class="banda-fondo ficha-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-oficina banda-primario">
          <p class="ficha-oficina-titulo">Antes de venir, pásate por la oficina</p>
          <p>Te damos el plano del pueblo y te contamos cómo está el camino.</p>
          {c.horario && <p class="ficha-horario">{c.horario}</p>}
          <a class="btn" href={contacto}>Contacto</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-piedra ficha-galeria-banda" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={900} alto={675} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-piedra ficha-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros lugares que ver" />
        <ul class="rejilla-lineas ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'montana'} tam={26} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <span class="ficha-otra-ver enlace-flecha" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los lugares</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-bottom: 0; }
  .ficha-migas-caja { padding-top: 1.25rem; }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .85rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .6; }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; text-decoration-color: var(--c-acento); text-underline-offset: 4px; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; margin-top: 1rem; }
  .ficha-hero-texto { padding: 2rem 1rem 3rem; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.4rem, 6.5vw, 5rem); overflow-wrap: anywhere; }
  .ficha-hero-texto .titular-texto { max-width: 34rem; }
  .ficha-precio { margin-top: 1.25rem; font-family: var(--fuente-titulos); font-weight: 700; font-size: 1.35rem; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; border-top: 6px solid var(--c-acento); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--c-acento); color: var(--c-sobre-acento); }
  .ficha-banda { padding-block: var(--ritmo); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; display: flow-root; }
  .ficha-detalle p:first-child::first-letter { float: left; font-family: var(--fuente-titulos); font-weight: 700; font-size: 4rem; line-height: .85; padding: .3rem .6rem 0 0; color: var(--c-acento); }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.3rem; margin-bottom: .75rem; color: var(--c-primario); }
  .ficha-datos { border-top: 3px solid var(--c-primario); padding-top: 1rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--c-linea); }
  .ficha-datos dt { font-weight: 800; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-oficina { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; border-top: 6px solid var(--c-acento); }
  .ficha-oficina-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; font-weight: 700; line-height: 1.15; }
  .ficha-horario { font-size: .95rem; opacity: .85; }
  .ficha-oficina .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .ficha-galeria-banda { padding: 0; }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { grid-template-columns: 1fr; }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem 1.5rem; }
  .ficha-otra:hover { background: color-mix(in srgb, var(--c-fondo) 60%, transparent); }
  .ficha-otra-icono { color: var(--c-acento); }
  .ficha-otra h3 { font-size: 1.4rem; color: var(--c-primario); overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: -3px; }
  .ficha-otra p { opacity: .85; }
  .ficha-otra-ver { margin-top: auto; color: var(--c-acento); }
  @media (min-width: 640px) { .ficha-otras { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: stretch; }
    .ficha-hero-texto { padding: 4rem 3rem 4.5rem max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); align-self: center; }
    .ficha-foto, .ficha-icono { aspect-ratio: auto; min-height: 30rem; border-top: 0; border-left: 8px solid var(--c-acento); }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
