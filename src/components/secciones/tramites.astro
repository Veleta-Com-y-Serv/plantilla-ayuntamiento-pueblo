---
// Sede y trámites: banda verde institucional a todo el ancho con una rejilla de trámites separada por líneas
// finas (sin tarjetas), 1-2-4 columnas. Cada trámite: {titulo, texto, icono, url}; con url, toda la celda es enlace.
// Botón opcional (cta) a la sede electrónica. Sin trámites, solo el titular y el botón.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = (s?.items ?? []).filter((it) => it && it.titulo);
---

{
  s && (
    <Seccion id={Astro.props.id} class="banda-primario">
      <div class="grid gap-x-12 lg:grid-cols-[1fr_auto] lg:items-end">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {s.cta?.url && <a class="btn mb-11 justify-self-start" href={s.cta.url}>{s.cta.texto}</a>}
      </div>
      {items.length > 0 && (
        <ul class="rejilla-lineas sm:grid-cols-2 lg:grid-cols-4">
          {items.map((it) => {
            const dentro = (
              <>
                <span class="tramite-icono" aria-hidden="true"><Icono nombre={it.icono} tam={26} /></span>
                <span class="tramite-titulo block font-display text-[1.3rem] font-bold leading-tight sm:text-[1.4rem]">{it.titulo}</span>
                {it.texto && <span class="tramite-texto block text-[.95rem] opacity-80">{it.texto}</span>}
                {it.url && <span class="tramite-flecha" aria-hidden="true"><Icono nombre="flecha" tam={20} /></span>}
              </>
            );
            return <li>{it.url ? <a href={it.url} class="tramite">{dentro}</a> : <div class="tramite">{dentro}</div>}</li>;
          })}
        </ul>
      )}
    </Seccion>
  )
}

<style>
  /* Móvil: filas compactas (icono, texto, flecha); desde 640 px, celdas de rejilla con la flecha abajo. */
  .tramite { position: relative; display: grid; grid-template-columns: 2.75rem 1fr 1.25rem; column-gap: 1rem; align-items: start; height: 100%; padding: 1.25rem 0; text-decoration: none; transition: background-color .15s ease; }
  .tramite-icono { grid-row: span 2; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; background: var(--c-acento); color: var(--c-sobre-acento); }
  .tramite-titulo { grid-column: 2; }
  .tramite-texto { grid-column: 2; margin-top: .25rem; }
  .tramite-flecha { grid-column: 3; grid-row: 1 / span 2; align-self: center; opacity: .7; transition: transform .15s ease, opacity .15s ease; }
  @media (min-width: 640px) {
    .tramite { display: flex; flex-direction: column; padding: 2rem 1.75rem 3.5rem; }
    .tramite-icono { width: 3.25rem; height: 3.25rem; }
    .tramite-titulo { margin-top: 1.25rem; }
    .tramite-texto { margin-top: .5rem; }
    .tramite-flecha { position: absolute; left: 1.75rem; bottom: 1.25rem; }
  }
  a.tramite:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
  a.tramite:hover .tramite-flecha { transform: translateX(6px); opacity: 1; }
</style>
