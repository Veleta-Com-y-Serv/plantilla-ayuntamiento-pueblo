---
// Actualidad (bandos, avisos y noticias): banda clara a todo el ancho con portada de periódico.
// La primera noticia va grande con su foto (a sangre en móvil); las demás, en columna con miniatura y líneas finas.
// Cada noticia: {fecha, categoria, titulo, texto, imagen, url opcional}. Sin noticias, solo el titular.
import { seccion } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const noticias = (s?.noticias ?? []).filter((n) => n && n.titulo);
const [lead, ...resto] = noticias;
---

{
  s && (
    <Seccion id={Astro.props.id} class="banda-fondo">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-2">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {s.cta?.url && (
          <a href={s.cta.url} class="enlace-flecha mb-11 text-primario">{s.cta.texto}<Icono nombre="flecha" tam={18} /></a>
        )}
      </div>
      {lead && (
        <div class:list={['grid gap-x-12 gap-y-10', resto.length > 0 && 'lg:grid-cols-12']}>
          <article class:list={['noticia-lead', resto.length > 0 && 'lg:col-span-7']}>
            {lead.imagen && (
              <div class="-mx-4 md:mx-0">
                <Imagen src={lead.imagen} alt={altFicha(lead)} ancho={1200} alto={800} class="aspect-[3/2] w-full object-cover" />
              </div>
            )}
            <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              {lead.categoria && <span class="etiqueta">{lead.categoria}</span>}
              {lead.fecha && <time class="opacity-70">{lead.fecha}</time>}
            </p>
            <h3 class="mt-3 text-[clamp(1.6rem,3.4vw,2.5rem)] text-primario">
              {lead.url ? <a href={lead.url} class="hover:underline">{lead.titulo}</a> : lead.titulo}
            </h3>
            {lead.texto && <p class="mt-4 max-w-2xl text-lg opacity-85">{lead.texto}</p>}
          </article>
          {resto.length > 0 && (
            <ul class="border-t-4 border-primario lg:col-span-5">
              {resto.map((n) => (
                <li class="grid grid-cols-[1fr_auto] gap-5 border-b border-[var(--c-linea)] py-6">
                  <div class="min-w-0">
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                      {n.categoria && <span class="etiqueta">{n.categoria}</span>}
                      {n.fecha && <time class="opacity-70">{n.fecha}</time>}
                    </p>
                    <h3 class="mt-2 text-xl leading-snug text-primario md:text-[1.4rem]">
                      {n.url ? <a href={n.url} class="hover:underline">{n.titulo}</a> : n.titulo}
                    </h3>
                    {n.texto && <p class="mt-2 text-[.95rem] opacity-80">{n.texto}</p>}
                  </div>
                  {n.imagen && <Imagen src={n.imagen} alt={altFicha(n)} ancho={600} alto={600} class="mt-1 aspect-square w-20 object-cover sm:w-28" />}
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </Seccion>
  )
}
